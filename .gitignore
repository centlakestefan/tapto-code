# Build output
/build/
/out/
*.o
*.obj
*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
# ...but the project's own cmake modules are source, and *.cmake above would
# swallow them without a word.
!cmake/*.cmake

# Editor / IDE
.vs/
.vscode/
.idea/

# Local Visual Studio project/solution files (machine-specific; CMake is canonical)
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
/build-ide/

# Local store is now central (~/.tapto/projects); kept as a safety net so a
# stray or legacy ./.tapto is never committed.
.tapto/
